{
    "ip_address": [
        {
            "key": "ipv4-addr.value",
            "object": "ip"
        },
        {
            "key": "network-traffic.dst_ref",
            "object": "nt",
            "references": "ip"
        },
        {
            "key": "x-criminalip-banner.ip_ref",
